DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty POSTGRES_HOST means SQLite (db.sqlite3). Set it to localhost to use the compose database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=radar_alerts
POSTGRES_USER=radar_alerts
POSTGRES_PASSWORD=

# Must match BLUESKY_TAGS of the radar; keep them in sync by hand.
RADAR_BLUESKY_TAGS=gamedev,indiedev,indiegame,godot,pixelart,screenshotsaturday,mobilegame

# RabbitMQ (compose.yaml requires RABBITMQ_PASSWORD).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=radar_alerts
RABBITMQ_PASSWORD=

# ClickHouse of the radar: read-only SQL interface alerts_v1 (views), user radar_alerts.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=radar_alerts
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=alerts_v1

# Telegram bot: empty token means no alerts are sent. Username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_URL=https://api.telegram.org

# Telegram mode: polling (default) or webhook. Webhook needs a secret of 1-256 characters [A-Za-z0-9_-]
# and a public https base URL (used only by `manage.py telegram_webhook set`).
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Only for docker compose: web port on 127.0.0.1, Celery worker processes,
# CLICKHOUSE_URL inside the worker container and the name of the radar's external docker network.
WEB_PORT=8000
WORKER_CONCURRENCY=2
DOCKER_CLICKHOUSE_URL=http://clickhouse:8123
RADAR_DOCKER_NETWORK=gamedev-trends_default
