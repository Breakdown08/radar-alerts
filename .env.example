DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty POSTGRES_HOST means SQLite (db.sqlite3). Set it to localhost to use the compose database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=radar_alerts
POSTGRES_USER=radar_alerts
POSTGRES_PASSWORD=

# Must match BLUESKY_TAGS of the radar; keep them in sync by hand.
RADAR_BLUESKY_TAGS=gamedev,indiedev,indiegame,godot,pixelart,screenshotsaturday,mobilegame
